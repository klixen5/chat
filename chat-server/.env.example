# npm start works without this file. Copy to .env only to change settings.
PORT=3001
HOST=127.0.0.1

# Leave DATABASE_URL unset to use the isolated PostgreSQL managed by npm start.
# Set this to use your own existing database instead:
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/chat

# Port of the isolated PostgreSQL. This does not affect an existing server on 5432.
LOCAL_PG_PORT=55432

# Optional path to the directory containing postgres, initdb and pg_ctl.
# PG_BINDIR=/opt/homebrew/opt/postgresql@17/bin

# Default: browser clients on localhost / 127.0.0.1 / [::1], on any port.
# To allow a specific deployed frontend, provide a comma-separated list:
# CLIENT_ORIGINS=http://localhost:5173,https://your-frontend.example
